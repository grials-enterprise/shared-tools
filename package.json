{
  "name": "@grials/shared-tools",
  "version": "1.0.0",
  "description": "Grials shared tools",
  "main": "dist/index.js",
  "types": "dist/index.d.ts",
  "files": [
    "dist/**/*"
  ],
  "scripts": {
    "husky-prepare": "husky install",
    "format": "prettier --write \"src/**/*.ts\" \"src/**/*.js\"",
    "build:ts": "rimraf dist/ && tsc -p tsconfig.build.json",
    "build": "bash build.sh",
    "lint": "eslint \"src/**/*.{js,ts}\"",
    "lint:fix": "eslint --fix \"src/**/*.{js,ts}\"",
    "prepare": "npm run husky-prepare",
    "prepublishOnly": "npm run lint",
    "preversion": "npm run lint",
    "precommit": "lint-staged",
    "version": "npm run format && git add -A src",
    "postversion": "git push && git push --tags",
    "test": "nyc mocha --file ./tests/setup.ts tests/**/*.spec.ts",
    "test:only": "mocha --file ./tests/setup.ts tests/**/*.spec.ts",
    "test:basic": "ts-node ./tests/basic.ts"
  },
  "repository": {
    "type": "git",
    "url": "git+https://github.com/grials-enterprice/shared-tools.git"
  },
  "author": {
    "name": "Jose Manuel Mendez Romero"
  },
  "license": "ISC",
  "bugs": {
    "url": "https://github.com/grials-enterprice/shared-tools/issues"
  },
  "homepage": "https://github.com/grials-enterprice/shared-tools#readme",
  "dependencies": {
    "axios": "^1.11.0",
    "moment": "^2.30.1",
    "rxjs": "^7.8.2",
    "type-check": "^0.4.0",
    "uuid": "^13.0.0"
  },
  "devDependencies": {
    "@istanbuljs/nyc-config-typescript": "^1.0.2",
    "@grials/testing-tools": "^1.0.4",
    "@types/mocha": "^10.0.10",
    "@types/node": "^22.15.29",
    "@types/type-check": "^0.3.31",
    "@typescript-eslint/parser": "^8.33.1",
    "commitizen": "^4.3.1",
    "cz-conventional-changelog": "^3.3.0",
    "eslint": "^9.28.0",
    "eslint-config-prettier": "^10.1.5",
    "eslint-plugin-prettier": "^5.4.1",
    "husky": "^9.1.7",
    "lint-staged": "^16.1.0",
    "mocha": "^11.5.0",
    "nock": "^14.0.10",
    "nyc": "^17.1.0",
    "prettier": "^3.5.3",
    "rimraf": "^6.0.1",
    "ts-node": "^10.9.2",
    "typescript": "5.8.3"
  },
  "config": {
    "commitizen": {
      "path": "./node_modules/cz-conventional-changelog"
    }
  }
}
