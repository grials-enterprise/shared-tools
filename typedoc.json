{
  "$schema": "https://typedoc.org/schema.json",
  "entryPoints": ["src/index.ts"],
  "out": "docs",
  "tsconfig": "tsconfig.build.json",
  "name": "@grials/shared-tools",
  "includeVersion": true,
  "excludePrivate": true,
  "excludeProtected": true,
  "excludeExternals": true,
  "hideGenerator": true,
  "categorizeByGroup": true,
  "sort": ["source-order"],
  "readme": "README.md"
}
